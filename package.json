{
  "name": "@fangorn-network/westmarch",
  "version": "0.3.0",
  "description": "Follows Fangorn repos into a searchable index, locally or as a Cloudflare Worker, and serves it to agents over MCP",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": "./src/stitcher.js",
    "./worker": "./worker/index.js",
    "./worker/*": "./worker/*.js",
    "./*": "./src/*.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "start": "node src/run.js app.json",
    "mcp": "node src/mcp.js app.json",
    "test": "vitest run",
    "sandbox": "node src/sandbox.js"
  },
  "dependencies": {
    "@fangorn-network/sdk": "^0.1.5",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "viem": "^2.56.3",
    "zod": "^4.6.7",
    "@huggingface/transformers": "^4.2.0"
  },
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "vitest": "^5.1.0"
  },
  "bin": {
    "westmarch": "./src/run.js",
    "westmarch-mcp": "./src/mcp.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fangorn-network/westmarch.git"
  },
  "files": [
    "src",
    "worker",
    "!**/*.test.js"
  ]
}
