    "lint": "node src/publish/lint.js"
  },
  "dependencies": {
    "@fangorn-network/markov": "^0.1.0"
  },
  "peerDependencies": {
    "@fangorn-network/sdk": "^2026.9.22-dev",
    "@huggingface/transformers": "^4.2.0",
