    "@huggingface/transformers": {
      "optional": true
    }
  },
  "devDependencies": {
    "@fangorn-network/sdk": "^2026.9.22-dev",
    "@huggingface/transformers": "^4.2.0",
    "@noble/curves": "^1.9.1",
    "@privy-io/react-auth": "^3.47.0",
    "@stripe/stripe-js": "^10.0.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^5.9.3",
    "viem": "^2.56.3"
