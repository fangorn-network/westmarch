    "./embed": "./src/core/embed.js",
    "./rank": "./src/core/rank.js",
    "./apps": "./src/discover/apps.js",
    "./explore": "./src/discover/explore.js",
    "./agent-card": "./src/agent/agent-card.js",
    "./view": "./src/publish/view.js",
    "./roles": "./src/core/roles.js",
    "./directory": "./src/discover/directory.js",
    "./taste": "./src/taste/taste.js",
    "./corpora": "./src/discover/corpora.js",
    "./ui": "./src/agent/ui.js",
    "./lint": "./src/publish/lint.js",
    "./terms": "./src/market/terms.js",
    "./reactions": "./src/market/reactions.js",
    "./cohort": "./src/market/cohort.js",
    "./vault": "./src/taste/vault.js",
    "./taste-doc": "./src/taste/taste-doc.js",
